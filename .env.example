# next dev: copy to .env.local. Never commit real keys.
AI_MODE=mock

# AIの提供元。anthropic（既定・仕様書 第18章）/ openai
AI_PROVIDER=anthropic

# 使うモデル。空なら既定値（anthropic: claude-opus-5 / openai: gpt-5.6-terra）
# OpenAI の選択肢: gpt-5.6-sol（高性能）/ gpt-5.6-terra（中間・既定）/ gpt-5.6-luna（安い）
ANTHROPIC_MODEL=
OPENAI_MODEL=

# APIキー。AI_MODE=real のとき、選んだ提供元のぶんだけあればよい
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
